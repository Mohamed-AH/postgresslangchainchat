# --- Datastore ---------------------------------------------------------------
# Plain postgresql:// is fine — the app normalises it to the psycopg3 driver.
DATABASE_URL=postgresql://ragchat:ragchat@localhost:5432/ragchat

# --- Providers ---------------------------------------------------------------
COHERE_API_KEY=your_cohere_api_key
GOOGLE_API_KEY=your_gemini_api_key

# --- Optional tunables (defaults shown) --------------------------------------
# EMBEDDING_MODEL=embed-english-v3.0
# EMBEDDING_DIMENSION=1024
# LLM_MODEL=gemini-1.5-flash
# LLM_TEMPERATURE=0.0
# RETRIEVER_K=3
# COLLECTION_NAME=qa_knowledge_base
# LOG_LEVEL=INFO
